datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  DJ
  VISUAL_ARTIST
}

model Event {
  id          String   @id @default(uuid())
  title       String
  sessionCode String
  dateText    String
  location    String
  bannerUrl   String
  ticketUrl   String   @default("#")
  isUpcoming  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isUpcoming])
}

model Artist {
  id         String   @id @default(uuid())
  name       String
  roleType   RoleType
  city       String
  genre      String
  avatarUrl  String?
  bio        String?
  socialUrl  String?
  isFeatured Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([roleType])
}

model ArchiveWork {
  id            String   @id @default(uuid())
  title         String
  sessionCode   String
  recordingDate String
  location      String
  videoUrl      String?
  thumbnailUrl  String?
  description   String   @default("Recorded Live Performance")
  isSelected    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  source       String   @default("landing_footer")
  subscribedAt DateTime @default(now())

  @@index([email])
}
